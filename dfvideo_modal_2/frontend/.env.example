VITE_GEN_API_BASE=/api/generate
VITE_GEN_MOCK=false
# Local backend or SSH tunnel to GPU server
GEN_API_ORIGIN=http://127.0.0.1:8002
# For HTTPS hosting set VITE_GEN_API_BASE to your GPU API HTTPS origin and
# GEN_CORS_ORIGINS on the server to the exact frontend origin, then rebuild.

# Vite 개발 서버 프록시 대상 Modal HTTPS 주소 (대시보드 주소가 아닌 실제 modal.run HTTPS 주소)
MODAL_VIDEO_API_ORIGIN=https://goyeas52--dfvideo-web.us-east.modal.run

# 브라우저에서 호출할 기본 경로 (개발 환경에서는 프록시 경로인 /api/video 사용)
VITE_VIDEO_API_BASE_URL=/api/video

# 텍스트 팩트체크 Modal 서버 주소
TEXT_API_ORIGIN=https://ykm20651--factrace-text-service-web.us-east.modal.run
# TEXT_API_ORIGIN=http://127.0.0.1:8001

# 브라우저에서 호출할 텍스트 API 기본 경로
VITE_TEXT_API_BASE_URL=/api/text
