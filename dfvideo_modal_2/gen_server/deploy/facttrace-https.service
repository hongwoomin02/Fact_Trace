[Unit]
Description=Fact Trace GPU HTTPS gateway
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=pukyong
Group=pukyong
Environment=XDG_DATA_HOME=/home/pukyong/FactTraceAI_gpu/https-data
Environment=XDG_CONFIG_HOME=/home/pukyong/FactTraceAI_gpu/https-config
ExecStart=/home/pukyong/FactTraceAI_gpu/tools/caddy run --config /home/pukyong/FactTraceAI_gpu/Caddyfile --adapter caddyfile
Restart=always
RestartSec=5
TimeoutStopSec=30
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pukyong/FactTraceAI_gpu/https-data /home/pukyong/FactTraceAI_gpu/https-config
UMask=0077

[Install]
WantedBy=multi-user.target
